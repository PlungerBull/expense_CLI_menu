/* App-wide styling. Colors come from theme variables (see theme.py) so a
   theme swap recolors everything — no hardcoded hex here. */

Screen {
    background: $background;
}

/* ---- home ---- */
#brand {
    padding: 1 2 1 2;
    color: $foreground;
    text-style: bold;
    border-bottom: solid $surface;  /* thin rule dividing header from menu */
}
/* No box: the menu sits directly on the app background (two surfaces, not
   three). `border: none` overrides OptionList's default `tall` border; group
   headers, the inter-group separators, and the selection bar carry the
   structure the box used to. */
#menu {
    height: 1fr;
    margin: 1 1 1 1;
    background: $background;
    border: none;
    padding: 0 1;
}

/* ---- section interface (Outstanding Amounts) ---- */
#crumb {
    padding: 1 2;
    color: $text-muted;
    border-bottom: solid $surface;
}
#content {
    height: 1fr;
    padding: 1 2;
}
/* the section content card; its max-width is set per-screen (SectionScreen.
   CARD_WIDTH) so amounts sit in a tidy column rather than spreading wide. */
#card {
    width: 1fr;
    height: auto;
}
.legend {
    color: $text-muted;
    margin-top: 1;
}
.sync-note {
    color: $text-muted;
    padding: 1 2;
}

/* quick-add log bar */
#inputbar {
    height: auto;
    margin: 1 2 0 2;
    max-width: 80;
    border: round $accent;
    padding: 0 1;
}
#field {
    width: 14;  /* longest label (BEGIN BALANCE, 13) + 1 right padding — guarded by test_tui_field_width.py */
    color: $accent;
    text-style: bold;
    content-align: left middle;
    padding: 0 1 0 0;
}
#inputbar Input {
    border: none;
    background: transparent;
    width: 1fr;
}
#hint {
    color: $text-muted;
    padding: 0 3;
}
#suggest {
    padding: 1 3 0 3;
    height: auto;
}
#summary {
    padding: 1 3;
    height: auto;
}

/* modal screens — center the #modal box (else it collapses top-left) */
RecordModal, SnapshotModal, ConfirmModal, PromptModal {
    align: center middle;
}
/* width is DEFINITE, not `auto`: inside `align: center middle` on Textual 8.x,
   `width: auto` measures to 0, collapsing the box to an empty border (Enter's
   detail view, the archive/delete confirm, and activity before/after all went
   invisible). max-width keeps it inside narrow terminals. Guarded by
   tests/unit/test_tui_modals.py so a Textual bump can't silently re-break it. */
#modal {
    width: 72;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    border: round $surface;
    background: $panel;
    padding: 1 2;
}
/* confirm/prompt carry short messages — a narrower box reads better */
ConfirmModal #modal, PromptModal #modal {
    width: 52;
    max-width: 90%;
}
.modal-title {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}
.section-title {
    color: $foreground;
    text-style: bold;
    margin: 0 0 1 0;
}
.sect {
    color: $accent;
    text-style: bold;
    margin: 1 0 0 0;
}
.error {
    color: $error;
    text-style: bold;
}
